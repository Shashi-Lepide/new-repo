{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "includeFiles": "src/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?route=/api/:path*" },
    { "source": "/assets/:path*", "destination": "/api/index?route=/assets/:path*" },
    { "source": "/:path*", "destination": "/api/index?route=/:path*" },
    { "source": "/", "destination": "/api/index?route=/" }
  ]
}
